# ─────────────────────────────────────────────────────────────
# Uniempresarial · Credenciales — variables de entorno
# Copia este archivo a .env.local (desarrollo) o configúralas en Vercel.
# ─────────────────────────────────────────────────────────────

# URL pública del portal (se usa en el botón de los correos)
NEXT_PUBLIC_APP_URL=https://credenciales.uniempresarial.edu.co

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# ¡Secreta! Solo servidor. Nunca la expongas con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Firma de la sesión del estudiante tras el OTP (mínimo 32 caracteres aleatorios)
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
STUDENT_SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-largo-de-48-bytes
# Opcional: secreto adicional para el hash de los OTP (si no, usa STUDENT_SESSION_SECRET)
OTP_PEPPER=

# Protege /api/cron/reminders (Vercel Cron envía "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=otro-valor-aleatorio-largo
REMINDER_HOURS=48
REMINDER_MAX=3
REMINDER_BATCH=150

# ── Correo ───────────────────────────────────────────────────
# graph (recomendado para Microsoft 365) | smtp | console (solo desarrollo)
MAIL_DRIVER=graph
MAIL_FROM=bienestar@uniempresarial.edu.co

# Solo si MAIL_DRIVER=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=bienestar@uniempresarial.edu.co
SMTP_PASS=
SMTP_RATE_PER_MINUTE=25

# ── Microsoft Graph (Entra ID App Registration) ─────────────
# Permisos de aplicación: Mail.Send, User.ReadWrite.All, User-PasswordProfile.ReadWrite.All
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Enlace del Sistema de Gestión Académico (SIGA) para su código QR
NEXT_PUBLIC_SIGA_URL=https://uniempresarial.datasae.co/siga_new/web/app.php/login_responsive
